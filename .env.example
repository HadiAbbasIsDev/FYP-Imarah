# Use: local server settings; copy to .env and fill the trained detector details.
# Copyright (c) 2026 Imarah.tech. All rights reserved.
IMARAH_HOST=127.0.0.1
IMARAH_PORT=8000
YOLO_ENDPOINT=
YOLO_API_KEY=
# Both use Bearer authentication when a key is set. Ultralytics Platform requires its deployment key.
# For Platform: use the full URL ending in /predict and YOLO_PROVIDER=ultralytics.
# Platform sends file, imgsz=640, conf=0.25, iou=0.7, normalize=false; no model ID is needed.
YOLO_PROVIDER=generic
YOLO_TIMEOUT_SECONDS=45
OLLAMA_URL=http://127.0.0.1:11435
VLM_TIMEOUT_SECONDS=300
# The Qwen 4B VPS option uses your open SSH tunnel; the separate Local option uses Ollama.
QWEN_VPS_URL=http://127.0.0.1:18084
QWEN_VPS_TIMEOUT_SECONDS=330

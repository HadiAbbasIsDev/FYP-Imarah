# Use: serve the Qwen image API privately; connect from a PC through an SSH tunnel.
# Copyright (c) 2026 Imarah.tech. All rights reserved.
[Unit]
Description=AIML Models - Qwen3-VL 4B image API
After=network-online.target aiml-qwen4-ollama.service
Wants=aiml-qwen4-ollama.service
RequiresMountsFor=/sdb-disk

[Service]
Type=simple
User=aiml-qwen
Group=aiml-qwen
Environment=QWEN_OLLAMA_URL=http://127.0.0.1:11440
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/sdb-disk/AIML-Models/VLM-models/qwen3-vl-4b-instruct-q4_k_m
ExecStart=/opt/aiml/venvs/qwen3-vl-4b-api/bin/python -m uvicorn serve:app --host 127.0.0.1 --port 18084 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
MemoryMax=1G
CPUQuota=200%
TasksMax=64
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/sdb-disk/AIML-Models/VLM-models/qwen3-vl-4b-instruct-q4_k_m/logs
StandardOutput=append:/sdb-disk/AIML-Models/VLM-models/qwen3-vl-4b-instruct-q4_k_m/logs/api.log
StandardError=append:/sdb-disk/AIML-Models/VLM-models/qwen3-vl-4b-instruct-q4_k_m/logs/api.log

[Install]
WantedBy=multi-user.target
